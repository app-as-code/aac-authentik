# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# REQUIRED - set for your environment
AUTHENTIK_EMAIL__FROM=CHANGE_ME

# SECRET - set a strong value
AUTHENTIK_EMAIL__PASSWORD=CHANGE_ME

# REQUIRED - set for your environment
AUTHENTIK_EMAIL__USERNAME=CHANGE_ME

# SECRET - set a strong value
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME

# SECRET - set a strong value
AUTHENTIK_SECRET_KEY=CHANGE_ME

# SECRET - set a strong value
HOMEPAGE_WIDGET_KEY=CHANGE_ME

# SECRET - set a strong value
POSTGRES_PASSWORD=CHANGE_ME

# default: authentik
POSTGRES_DB=authentik

# default: authentik
POSTGRES_USER=authentik
